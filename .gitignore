# scratch dumps from large fuzz/comparison runs (thousands of .trf/.txt
# files, not meant to be tracked) — see overnight_run/run.sh. Covers
# every dated/versioned dump directory (bye/, forfeit/, bye_v1_pre_fix/,
# etc.), not just the two names run.sh currently writes.
/overnight_run/bye*/
/overnight_run/forfeit*/
/overnight_run/*.log
/matching_baseline.bin

# Scratch outputs of the one-off tools, committed by accident and removed
# 2026-08-27. `forced_exchange.trf` is what `tools/forced_exchange.exs`
# writes into the working directory; `solve_input.bin` (1.1 MB) was a
# matcher input dumped during the delta-scan work and is referenced by
# nothing.
/forced_exchange.trf
/solve_input.bin
